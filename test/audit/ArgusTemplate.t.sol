pragma solidity 0.8.37;

// Checks the real Argus launchpad hook on Arc against the hardened template rules.
// Bytecode captured from 0x399218a6395d79c695ad4e95d53a6ed3914f2044 at block 22364090.

import {Test} from "forge-std/Test.sol";
import {CovenRouter} from "../../src/CovenRouter.sol";
import {ICovenRouter} from "../../src/interfaces/ICovenRouter.sol";
import {Mask} from "../utils/Mask.sol";

contract ArgusTemplateTest is Test {
    address constant ARGUS = 0x399218a6395D79C695Ad4E95d53a6eD3914F2044;
    CovenRouter router;
    address owner = makeAddr("owner");

    function setUp() public {
        router = new CovenRouter(
            owner, makeAddr("treasury"), makeAddr("guardian"), 30,
            new address[](0), new ICovenRouter.TemplateInit[](0)
        );
        vm.etch(ARGUS, hex"");
    }

    function _windows() internal pure returns (ICovenRouter.MaskWindow[] memory w) {
        w = new ICovenRouter.MaskWindow[](14);
        w[0] = ICovenRouter.MaskWindow({offset: 488, length: 20});
        w[1] = ICovenRouter.MaskWindow({offset: 855, length: 2});
        w[2] = ICovenRouter.MaskWindow({offset: 944, length: 2});
        w[3] = ICovenRouter.MaskWindow({offset: 1126, length: 20});
        w[4] = ICovenRouter.MaskWindow({offset: 1611, length: 20});
        w[5] = ICovenRouter.MaskWindow({offset: 1684, length: 20});
        w[6] = ICovenRouter.MaskWindow({offset: 1764, length: 2});
        w[7] = ICovenRouter.MaskWindow({offset: 1802, length: 2});
        w[8] = ICovenRouter.MaskWindow({offset: 1886, length: 20});
        w[9] = ICovenRouter.MaskWindow({offset: 2163, length: 20});
        w[10] = ICovenRouter.MaskWindow({offset: 2783, length: 2});
        w[11] = ICovenRouter.MaskWindow({offset: 2829, length: 2});
        w[12] = ICovenRouter.MaskWindow({offset: 3427, length: 20});
        w[13] = ICovenRouter.MaskWindow({offset: 3487, length: 20});
    }

    function _legacyOffsets() internal pure returns (uint16[] memory o) {
        o = new uint16[](14);
        o[0] = 488;
        o[1] = 855;
        o[2] = 944;
        o[3] = 1126;
        o[4] = 1611;
        o[5] = 1684;
        o[6] = 1764;
        o[7] = 1802;
        o[8] = 1886;
        o[9] = 2163;
        o[10] = 2783;
        o[11] = 2829;
        o[12] = 3427;
        o[13] = 3487;
    }

    function test_exactLengthWindowsRegisterAndMatch() public {
        vm.prank(owner);
        bytes32 id = router.addHookTemplate(ARGUS, _windows());
        (uint256 size, uint16 flags, ICovenRouter.MaskWindow[] memory got) = router.hookTemplate(id);
        assertEq(size, ARGUS.code.length, "code size recorded");
        assertEq(uint256(flags), uint256(uint160(ARGUS) & 0x3FFF), "hook flags bound to the template");
        assertEq(got.length, 14, "all windows stored");
        assertTrue(router.isHookAllowed(ARGUS), "the reference hook matches its own template");
    }

    function test_totalMaskedBytesIsTheConstantsOnly() public pure {
        ICovenRouter.MaskWindow[] memory w = _windows();
        uint256 total;
        for (uint256 i; i < w.length; ++i) total += w[i].length;
        assertEq(total, 172, "8 addresses and 6 uint16s");
    }

    /// The originally-planned 32-byte windows overrun their PUSH32 immediates and blanket
    /// 276 bytes of executable code. Registration now refuses them.
    function test_legacy32ByteWindowsAreRejected() public {
        vm.prank(owner);
        vm.expectRevert(abi.encodeWithSelector(ICovenRouter.MaskCoversCode.selector, uint16(488)));
        router.addHookTemplate(ARGUS, Mask.windows(_legacyOffsets()));
    }

    /// The swap-permission bits are set, so Argus pools do require the allowlist.
    function test_argusNeedsTheAllowlist() public view {
        uint160 swapFlags = router.SWAP_HOOK_FLAGS();
        assertTrue(uint160(ARGUS) & swapFlags != 0, "Argus holds swap permissions");
    }
}
